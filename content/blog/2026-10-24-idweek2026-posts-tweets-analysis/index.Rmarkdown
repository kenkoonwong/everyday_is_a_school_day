> 860 posts 📉 a new low for #IDWeek2026 on social media! But the learning didn’t stop 🧠 Waning measles antibodies in infants, oral care to cut NV-HAP 🪥, MedGemma for TB 🫁, and more! Thank you all who have contributed! 


```{r,eval=F,echo=F}
### posts
library(tidyverse)
library(wordcloud)
library(wordcloud2)
library(tidytext)

load("idweek26_merge.rda")

wc <- 
  merge_clean %>% 
  select(text) %>%
  pivot_longer(cols = "text", names_to = "title", values_to = "word") %>%
  unnest_tokens(word, word) %>%
  filter(!str_detect(word, "^id$|idtwitter|idweek2026|idsky|idweek26|http|t\\.co|amp|^[[:digit:]]+|idweek|^2026$|booth")) %>%
  anti_join(stop_words) %>%
  count(word) |>
  filter(n > 5) 

# wc_full <- wordcloud(words = wc$word, freq = wc$n, random.order = FALSE, colors = brewer.pal(8,"Dark2"))

wc_full <- wordcloud2(wc, size=1.6, color='random-dark')
wc_full

```

